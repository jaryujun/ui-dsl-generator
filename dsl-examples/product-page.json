{
  "page": {
    "name": "ProductDetail",
    "dsl_version": "0.2.0",
    "layout": "column",
    "children": [
      {
        "type": "swiper",
        "props": {
          "images": [
            "/static/products/prod-1.jpg",
            "/static/products/prod-2.jpg",
            "/static/products/prod-3.jpg"
          ],
          "navigation": "dots",
          "autoplay": true
        }
      },
      {
        "type": "section",
        "props": { "padding": "20rpx" },
        "children": [
          {
            "type": "text",
            "props": {
              "content": "TDesign 高品质无线蓝牙耳机",
              "style": { "font_size": "32rpx", "font_weight": "bold", "color": "#333" }
            }
          },
          {
            "type": "text",
            "props": {
              "content": "¥299.00",
              "style": { "font_size": "40rpx", "color": "#e4393c", "margin_top": "16rpx" }
            }
          },
          {
            "type": "tag",
            "props": {
              "content": "新品",
              "theme": "primary",
              "variant": "light"
            }
          },
          {
            "type": "text",
            "props": {
              "content": "超长续航 · 主动降噪 · 高清通话",
              "style": { "font_size": "24rpx", "color": "#999", "margin_top": "12rpx" }
            }
          }
        ]
      },
      {
        "type": "button",
        "props": {
          "text": "立即购买",
          "theme": "primary",
          "size": "large",
          "block": true,
          "onTap": "handleBuyNow"
        }
      }
    ]
  }
}
